                    "gateway":  "node packages/gateway/dist/server.js",
                    "migrate:export":  "node scripts/migrate-export.mjs"
                },
    "devDependencies":  {
                            "@types/node":  "^22.10.2",
                            "typescript":  "~5.7.2",
                            "vitest":  "^3.2.4"
                        }
}
