{
    "name":  "fin-alfred",
    "version":  "0.2.0",
    "private":  true,
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=24.0.0"
                },
    "workspaces":  [
                       "packages/core",
                       "packages/provider-akshare",
                       "packages/gateway",
                       "packages/cli",
                       "packages/ui"
                   ],
    "scripts":  {
                    "build":  "tsc -b",
