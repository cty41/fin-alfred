{
  "name": "dsh-alfred",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./client": { "default": "./dist/client.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "presets",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-conversation"],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b && npm run client:build",
    "client:build": "npm run client:typecheck && node scripts/build-client.mjs",
    "client:typecheck": "tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run --root ../.. packages/dsh-alfred/test"
  },
  "dependencies": {
    "@fin-alfred/core": "file:../core",
    "@fin-alfred/provider-akshare": "file:../provider-akshare"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.9",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
